# Helium (Required)
HELIUM_CONFIG_HOST='https://config.iot.mainnet.helium.io:6080'
HELIUM_KEYPAIR_PATH='/path/to/helium/delegate_key.bin'
HELIUM_KEYPAIR_BIN='/app/delegate_key.bin'
HELIUM_NET_ID='000003'
HELIUM_OUI='12345'
HELIUM_MAX_COPIES='15'
ROUTE_ID='00000000-0000-0000-0000-000000000000'
# SQLite DB Name (Required)
SQLITE_DATABASE_NAME='chirpstack-hpr-v2.db'
# ChirpStack (Required)
CHIRPSTACK_SERVER='chirpstack:8080'
CHIRPSTACK_APIKEY='your-admin-chirpstack-api-key'
REDIS_HOST='redis'
# Optional direct SQS usage publishing
PUBLISH_USAGE_EVENTS='False'
PUBLISH_USAGE_EVENTS_PROVIDER='AWS_SQS'
PUBLISH_USAGE_EVENTS_SQS_URL=''
PUBLISH_USAGE_EVENTS_SQS_REGION='us-east-1'
# Optional credentials; leave unset when using an IAM/workload role.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_SESSION_TOKEN=''
# With publishing enabled, stream positions are saved in Redis. First start skips
# old uplinks; API requests still replay. Restarts resume saved positions.
# Run one replica per route. Events before the first snapshot need reconciliation
# if they had not already been billed.
# Failed sends pause stream processing until delivery succeeds. Redis must retain
# source events throughout outages; delivery can repeat after a crash.
